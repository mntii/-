# Instagram Credentials
INSTAGRAM_USERNAME=your_username_here
INSTAGRAM_PASSWORD=your_password_here

# Bot Settings
CHECK_INTERVAL=30          # Seconds between DM checks
MAX_RETRIES=3              # Max retry attempts on failure
DOWNLOAD_FOLDER=downloads  # Local folder for downloaded media
SESSION_FILE=session.json  # Session persistence file
LOG_LEVEL=INFO             # DEBUG, INFO, WARNING, ERROR

# Optional: Proxy (leave empty to disable)
PROXY_URL=

# Optional: Delay settings (seconds) to mimic human behavior
MIN_ACTION_DELAY=2
MAX_ACTION_DELAY=6
